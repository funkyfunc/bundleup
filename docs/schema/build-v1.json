{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/funkyfunc/bundleup/blob/main/docs/schema/build-v1.json",
  "title": "bundleup build --json, schema version 1",
  "description": "One document on stdout at exit, on success and failure. Within schema_version 1 changes are additive only: consumers must ignore unknown keys (docs/cli-style-guide.md rules 16-20).",
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "ok",
    "exit_code",
    "result",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2,
        3,
        130
      ]
    },
    "result": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "output",
            "size_bytes",
            "name",
            "version",
            "packages",
            "native",
            "target",
            "duration_s",
            "timings"
          ],
          "properties": {
            "output": {
              "type": "string",
              "description": "Relative to the project directory when inside it"
            },
            "parts": {
              "type": [
                "string",
                "null"
              ],
              "description": "With --split, the folder of parts beside the output when the bundle didn't fit in one file (added within version 1, ADR-0045); size_bytes counts them too"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "name": {
              "type": "string"
            },
            "version": {
              "type": [
                "string",
                "null"
              ],
              "description": "null for a PEP 723 script"
            },
            "packages": {
              "type": "integer",
              "minimum": 0
            },
            "native": {
              "type": "boolean",
              "description": "Contains compiled code, so tied to one CPU"
            },
            "target": {
              "type": "object",
              "required": [
                "python",
                "python_full_version",
                "implementation",
                "platform",
                "machine"
              ],
              "properties": {
                "python": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+$"
                },
                "python_full_version": {
                  "type": "string"
                },
                "implementation": {
                  "type": "string"
                },
                "platform": {
                  "type": "string",
                  "description": "sys.platform, e.g. darwin, linux, win32"
                },
                "machine": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "null: runs on any CPU"
                },
                "python_platform": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "uv's platform name when built for another platform; null when built for this machine (added within version 1)"
                },
                "python_range": {
                  "type": "object",
                  "description": "Every Python minor version the bundle runs on (added within version 1, ADR-0030): exactly `python` when it has compiled code",
                  "required": [
                    "min",
                    "max"
                  ],
                  "properties": {
                    "min": {
                      "type": "string",
                      "pattern": "^[0-9]+\\.[0-9]+$"
                    },
                    "max": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^[0-9]+\\.[0-9]+$",
                      "description": "null: no upper limit"
                    }
                  }
                },
                "any_os": {
                  "type": "boolean",
                  "description": "Runs on Linux, macOS and Windows alike: pure Python, and the lock selects the same packages everywhere (added within version 1, ADR-0034)"
                }
              }
            },
            "duration_s": {
              "type": "number",
              "minimum": 0
            },
            "timings": {
              "type": "object",
              "description": "Seconds per build step",
              "propertyNames": {
                "enum": [
                  "python",
                  "export",
                  "install",
                  "compile",
                  "check",
                  "zip",
                  "verify",
                  "write",
                  "smoke"
                ]
              },
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            },
            "format": {
              "enum": [
                "pyz",
                "py",
                "dir",
                "lambda"
              ],
              "description": "What was written (added within version 1)"
            },
            "entry": {
              "type": [
                "string",
                "null"
              ],
              "description": "What runs: module:function, module, or the script's path; null for a dir or Lambda output with none (added within version 1)"
            },
            "payloads": {
              "type": "array",
              "description": "A bundle for several platforms (added within version 1, ADR-0038): each payload's target, shaped like `target`; empty for a single payload",
              "items": {
                "type": "object"
              }
            },
            "smoke": {
              "type": [
                "object",
                "null"
              ],
              "description": "What --smoke ran (added within version 1): the command, its exit code, the seconds it took, and whether the network was blocked; null without --smoke or when the bundle can't run here",
              "properties": {
                "command": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "exit_code": {
                  "type": "integer"
                },
                "seconds": {
                  "type": "number"
                },
                "network_blocked": {
                  "type": "boolean"
                }
              }
            },
            "against": {
              "type": [
                "object",
                "null"
              ],
              "description": "The --against file, if one was given (added within version 1, ADR-0044): its file, name, source, checked date, network and installs facts, and the flags it stood for"
            }
          }
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "level",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable slug; branch on this, not on message"
          },
          "level": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "package": {
            "type": "string",
            "description": "The distribution it's about, canonical name (added within version 1)"
          },
          "file": {
            "type": "string",
            "description": "POSIX path inside the bundle (added within version 1)"
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "description": "Line in file (added within version 1)"
          }
        }
      }
    }
  }
}
