{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/funkyfunc/bundleup/blob/main/docs/schema/check-v1.json",
  "title": "bundleup check --json, schema version 1",
  "description": "One document on stdout at exit. ok is false when the check found errors (or warnings, with --strict), or when it couldn't run (result is then null). Within schema_version 1 changes are additive only: consumers must ignore unknown keys (docs/cli-style-guide.md rules 16-20).",
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "ok",
    "exit_code",
    "result",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command": {
      "const": "check"
    },
    "ok": {
      "type": "boolean"
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2,
        3,
        130
      ]
    },
    "result": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "name",
            "version",
            "target",
            "native",
            "size_bytes",
            "packages",
            "duration_s"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": [
                "string",
                "null"
              ],
              "description": "null for a PEP 723 script"
            },
            "target": {
              "type": "object",
              "required": [
                "python",
                "python_full_version",
                "implementation",
                "platform",
                "machine"
              ],
              "properties": {
                "python": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+$"
                },
                "python_full_version": {
                  "type": "string"
                },
                "implementation": {
                  "type": "string"
                },
                "platform": {
                  "type": "string",
                  "description": "sys.platform, e.g. darwin, linux, win32"
                },
                "machine": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "null: runs on any CPU"
                },
                "python_platform": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "uv's platform name when built for another platform; null when built for this machine (added within version 1)"
                }
              }
            },
            "native": {
              "type": "boolean",
              "description": "Contains compiled code, so tied to one CPU"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0,
              "description": "Everything in the bundle once unpacked"
            },
            "packages": {
              "type": "array",
              "description": "Largest first",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "version",
                  "size_bytes",
                  "native"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Canonical distribution name"
                  },
                  "version": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "null for a PEP 723 script"
                  },
                  "size_bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Unpacked, compiled bytecode included"
                  },
                  "native": {
                    "type": "boolean"
                  }
                }
              }
            },
            "duration_s": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "description": "Codes: syntax-error (error in the project's code, warning in a dependency), data-files (warning), or any build error code",
      "items": {
        "type": "object",
        "required": [
          "code",
          "level",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable slug; branch on this, not on message"
          },
          "level": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "package": {
            "type": "string",
            "description": "The distribution it's about, canonical name (added within version 1)"
          },
          "file": {
            "type": "string",
            "description": "POSIX path inside the bundle (added within version 1)"
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "description": "Line in file (added within version 1)"
          }
        }
      }
    }
  }
}
